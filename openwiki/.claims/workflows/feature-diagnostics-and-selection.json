    {
      "id": "claim_e8b42e1c1b9746f6b867b5146b2e4472",
      "statement": "The look-ahead auditor tests temporal causality by rerunning an extractor after corrupting post-cutoff inputs, measuring extractor nondeterminism in two baseline runs, and flagging pre-cutoff feature changes above a per-feature tolerance derived from the noise floor.",
      "evidence": [
        {
          "resource": "repo://src/ml4t/diagnostic/evaluation/causality.py#L1-L38",
          "version": "repo-lines-v1:sha256:7443a81fba964ea9d939904f9bfc0aa0cf6790268c361dcd9e9df6f646c8035e:"
        },
        {
